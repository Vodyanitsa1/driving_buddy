# TEMPAT TERDEKAT (dipakai server.py lewat folder nearby_places/)
# Salin baris yang perlu ke file .env di root repo (file .env sudah di .gitignore).
# API key ini RAHASIA dan hanya dibaca server Python. Jangan taruh di aplikasi Flutter,
# jangan di-commit, jangan dikirim lewat chat.
#
# Provider: google | osm | snapshot | mock
#   mock   = tempat palsu, tanpa internet/key (bawaan kalau tidak ada yang diisi)
#   osm    = OpenStreetMap, gratis tanpa kartu kredit. Untuk demo/development saja.
#   snapshot = salinan OpenStreetMap di file places_snapshot.json (offline, lihat README_MAPS.md "Data offline")
#   google = Google Places API (New). Butuh project Google Cloud dengan billing aktif.
PLACES_PROVIDER=mock
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Opsional ------------------------------------------------------------------
# Cadangan kalau provider utama gagal / jatah habis (pilihan: osm, snapshot)
# PLACES_FALLBACK_PROVIDER=osm
#
# Jatah panggilan ke Google. Bawaan sengaja di bawah jatah gratis Nearby Search Pro (5.000/bulan).
# 0 = tanpa batas (jangan, kecuali quota cap di Google Cloud Console sudah dipasang).
# PLACES_GOOGLE_DAILY_BUDGET=300
# PLACES_GOOGLE_MONTHLY_BUDGET=4500
#
# true = minta rating + status buka/tutup. Google menagih tier Enterprise (jatah gratis 1.000/bulan,
# lalu $35 per 1.000), jadi batas bulanan bawaan turun ke 900.
# PLACES_GOOGLE_RATING_HOURS=false
#
# Tipe tempat Google (daftar "Table A" Places API) kalau hasil rest area/minimarket kurang pas:
# PLACES_GOOGLE_TYPES_REST_AREA=rest_stop
# PLACES_GOOGLE_TYPES_MINIMARKET=convenience_store
# PLACES_GOOGLE_TYPES_LODGING=hotel,motel,guest_house,lodging
# PLACES_GOOGLE_TYPES_SPBU=gas_station
#
# PLACES_TIMEOUT_S=4
# PLACES_CACHE_TTL_S=90
# PLACES_RATE_PER_CLIENT_PER_MIN=20
# PLACES_USAGE_FILE=off
#
# OpenStreetMap (Overpass) ---------------------------------------------------
# Beberapa server dipisah koma: dicoba berurutan kalau yang depan gagal (timeout/5xx/putus/429).
# Catatan: maps.mail.ru milik VK (Rusia); koordinat pencarian ikut terkirim ke sana. Hapus kalau tidak mau.
# PLACES_OSM_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# PLACES_OSM_TIMEOUT_S=8       batas satu percobaan ke satu server
# PLACES_OSM_DEADLINE_S=20     batas total semua percobaan (app Flutter menunggu 30 dtk)
# auto = httpx, pindah ke curl kalau TLS Python gagal (Python bawaan macOS/LibreSSL) | httpx | curl
# PLACES_OSM_TRANSPORT=auto
# PLACES_OSM_DAILY_BUDGET=500
#
# Cache basi: kalau semua server gagal, pakai hasil lama (diberi label "data tersimpan"). 0 = mati.
# PLACES_STALE_TTL_S=21600
# Opsional, simpan cache basi ke file supaya tahan restart server. Berisi titik pencarian (lokasi), jangan di-commit.
# PLACES_STALE_CACHE_FILE=.places_stale_cache.json
#
# Data offline (provider snapshot) ------------------------------------------
# Untuk demo: jawab instan dari file, Overpass live hanya untuk lokasi di luar area file.
# PLACES_PROVIDER=snapshot
# PLACES_FALLBACK_PROVIDER=osm
# Bawaan: places_snapshot.json di root repo. Berisi data publik OSM saja (tanpa lokasi pengguna).
# PLACES_SNAPSHOT_FILE=places_snapshot.json
