# SUPABASE CONFIGURATION
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# LLM CHAT (dipakai server.py lewat folder llm_chat/, lihat README_LLM.md)
# API key ini RAHASIA dan hanya dibaca server Python. Jangan taruh di aplikasi Flutter
# dan jangan di-commit (file .env sudah ada di .gitignore).
# Provider: groq | gemini | openai | custom | mock
# Kosong dan tanpa key = mock (balasan palsu, cocok buat ngerjain frontend).
LLM_PROVIDER=groq
LLM_API_KEY=YOUR_GROQ_API_KEY
# Opsional, sudah ada default per provider:
# LLM_MODEL=openai/gpt-oss-120b   # alternatif lebih ringan: openai/gpt-oss-20b
# LLM_TIMEOUT_S=8
# LLM_MAX_TOKENS=512        # kalau balasan sering kosong (error "empty"): naikkan ke 1024
# LLM_TEMPERATURE=0.7
# LLM_REASONING_EFFORT=low  # hanya untuk model yang mendukung
